# ==============================================================================
# Environment Configuration (.env) - Free AI Multimodal Assistant
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
ENVIRONMENT=development

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Default AI Providers
# Choices: "ollama" (Local, Free), "groq" (Free Tier), "gemini" (Free Tier)
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3.2:1b

# Ollama Local Server
OLLAMA_BASE_URL=http://localhost:11434

# Free-Tier Cloud API Keys (Optional - Never required for local Ollama/Faster-Whisper)
GROQ_API_KEY=
GEMINI_API_KEY=

# Speech-to-Text Settings
# Choices: "faster-whisper" (Local), "vosk" (Local)
DEFAULT_STT_PROVIDER=faster-whisper
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Text-to-Speech Settings
# Choices: "edge-tts" (Free, High-Quality, No Key), "kokoro" (Local), "piper" (Local)
DEFAULT_TTS_PROVIDER=edge-tts
DEFAULT_TTS_VOICE=en-US-JennyNeural
DEFAULT_TTS_SPEED=1.0

# Audio Storage
AUDIO_CACHE_DIR=./temp_audio
MAX_AUDIO_UPLOAD_MB=25

