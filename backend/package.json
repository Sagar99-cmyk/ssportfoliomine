{
  "name": "sagar-portfolio-backend",
  "version": "1.0.0",
  "description": "Production Node/Express & MySQL API Backend for Sagar Singh's Portfolio & Admin Command Center",
  "main": "server.ts",
  "type": "module",
  "scripts": {
    "start": "node --import tsx server.ts",
    "dev": "node --import tsx server.ts",
    "db:migrate": "node --import tsx database/cli.ts migrate",
    "db:seed": "node --import tsx database/cli.ts seed",
    "db:status": "node --import tsx database/cli.ts status"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mysql2": "^3.24.6",
    "nodemailer": "^6.9.16",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.17",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}

