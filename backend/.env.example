# Server Port
PORT=3000

# Environment Mode
NODE_ENV=development

# Application Base URL
APP_URL=http://localhost:3000

# Admin JWT Secret for Authentication
JWT_SECRET=your_production_jwt_secret_key_change_me

# MySQL Database Configuration (Local MySQL or external cloud MySQL)
MYSQL_ENABLED=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=sagar_portfolio_db
# MYSQL_URL=mysql://user:pass@host:port/database

# ==============================================================================
# SMTP Email Integration (Gmail / Nodemailer Real Email Sending)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
EMAIL_FROM="Portfolio Admin <your_email@gmail.com>"
