{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true
  },
  "include": ["server.ts", "rateLimiter.ts", "database/**/*.ts"],
  "exclude": ["node_modules"]
}

