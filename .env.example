# ==============================================================================
# Environment Configuration Template (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      Windows PowerShell: Copy-Item .env.example .env
#      macOS / Linux:     cp .env.example .env
# 2. Fill in your personal GEMINI_API_KEY and MYSQL_PASSWORD below.
# 3. Start the application with 'npm run dev'.
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# Application Base URL
# Used for internal redirects, asset references, and API base resolution
APP_URL=http://localhost:3000

# Google Gemini API Key
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Gemini Model Name (default: gemini-3.8-flash)
# Options: gemini-3.8-flash, gemini-3.8-pro, gemini-2.5-flash
GEMINI_MODEL=gemini-3.8-flash

# Sarvam AI API Key (Multilingual Indian Voice & Speech API)
SARVAM_API_KEY=""

# ==============================================================================
# MySQL Relational Database Configuration
# ==============================================================================
# Enabled flag: set to true to connect to MySQL
MYSQL_ENABLED=true

# Host address (default: localhost or 127.0.0.1 for local, or your cloud DB host)
MYSQL_HOST=localhost

# Port number (default MySQL port: 3306)
MYSQL_PORT=3306

# Username (default: root)
MYSQL_USER=root

# Password for your MySQL user
MYSQL_PASSWORD=

# Portfolio database name
MYSQL_DATABASE=sagar_portfolio_db

# (Optional) Cloud Database Connection URL (e.g. Railway, PlanetScale, Supabase)
# If provided, this overrides individual host/port/user settings
# MYSQL_URL=mysql://root:password@containers-us-west-1.railway.app:3306/railway

# Admin Security & Authentication Secret
JWT_SECRET=your_random_secure_jwt_secret_change_in_production

# ==============================================================================
# SMTP Email Integration (Gmail / Nodemailer Real Email Sending)
# ==============================================================================
# To send real emails from the Admin Contact Inbox:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password: https://myaccount.google.com/apppasswords (Select App: Mail)
# 3. Paste your 16-character code below as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_gmail_app_password
EMAIL_FROM="Portfolio Admin <your_email@gmail.com>"
